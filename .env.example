# Database
DATABASE_URL="postgresql://..."
DATABASE_URL_UNPOOLED="postgresql://..."

# Timezone Configuration
TZ="Asia/Dhaka"
NEXT_PUBLIC_TIMEZONE="Asia/Dhaka"

# Google Drive Integration (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id_here"

# Application Base URL (for Email Links, Dashboard Buttons, etc.)
# Set to your VPS domain or IP (e.g. https://yourdomain.com/database or http://123.45.67.89:3000/database)
APP_URL="https://yourdomain.com/database"
NEXT_PUBLIC_APP_URL="https://yourdomain.com/database"
