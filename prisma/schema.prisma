generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Institution {
  id                      String    @id @default(cuid())

  instituteName           String
  instituteNameBangla     String?
  domain                  String?
  category                String    // "Website" | "Software"
  instituteType           String    // School/College/Madrasah/University/Polytechnic/Kindergarten/Other

  issueDate               DateTime?
  expireDate              DateTime?
  actualExpireDate        DateTime?

  student                 String?
  condition               String?

  btclUsername            String?
  btclPassword            String?
  btclMobileNo            String?
  btclEmail               String?
  btclEmailPassword       String?

  instituteHead           String?
  contact1                String?
  contact2                String?
  inChargeTeacher         String?
  designation             String?
  inChargeTeacherContact  String?

  subDistrict             String?
  district                String?
  address                 String?   @db.Text

  // Arbitrary user-defined fields: { "<fieldKey>": "value", ... }
  customFields            Json      @default("{}")

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  tasks                   Task[]

  @@index([instituteType])
  @@index([category])
  @@index([subDistrict])
  @@index([district])
  @@index([expireDate])
  @@index([deletedAt])
}

model CustomFieldDefinition {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  fieldType String   @default("text") // text | number | date
  createdAt DateTime @default(now())
}

model SiteSettings {
  id           String    @id @default("global")
  password     String    @db.Text
  adminEmail   String?   @db.LongText
  otpCode      String?   @db.Text
  otpExpiresAt DateTime?
}

model TargetedClient {
  id                  String   @id @default(cuid())
  instituteName       String
  instituteNameBangla String?
  contactPerson       String?
  phone               String?
  email               String?
  district            String?
  subDistrict         String?
  address             String?  @db.Text
  priority            String   @default("Default") // "High" | "Default" | "Low"
  isArchived          Boolean   @default(false)
  notes               String?  @db.Text

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  @@index([priority])
  @@index([isArchived])
  @@index([district])
  @@index([subDistrict])
  @@index([deletedAt])
}

model Employee {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String?
  role         String    @default("EMPLOYEE") // "SUPER_ADMIN" | "EMPLOYEE"
  orderSerial  Int       @default(0)
  designation  String?
  phone        String?
  avatarColor  String?
  avatarUrl    String?   @db.LongText
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  assignedTasks          Task[]           @relation("AssignedTasks")
  createdTasks           Task[]           @relation("CreatedTasks")
  taskAssignees          TaskAssignee[]

  @@index([orderSerial])
  @@index([deletedAt])
}

model Task {
  id              String       @id @default(cuid())
  title           String
  description     String?      @db.Text
  dueDate         DateTime
  status          String       @default("To Do") // "To Do" | "In Progress" | "In Review" | "Completed" | "Canceled"
  priority        String       @default("Medium")  // "Urgent" | "High" | "Medium" | "Low"
  completionNote  String?      @db.Text
  progress        Int          @default(0)
  isMonthly       Boolean      @default(false)
  monthlyRecurringDay Int?

  institutionId   String?
  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  institutionName String?

  assignedToId    String?
  assignedTo      Employee?    @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignees       TaskAssignee[]

  assignedById    String?
  assignedBy      Employee?    @relation("CreatedTasks", fields: [assignedById], references: [id], onDelete: SetNull)

  subtasks        Subtask[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  @@index([dueDate])
  @@index([status])
  @@index([priority])
  @@index([isMonthly])
  @@index([institutionId])
  @@index([assignedToId])
  @@index([assignedById])
  @@index([deletedAt])
}

model TaskAssignee {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([taskId, employeeId])
  @@index([taskId])
  @@index([employeeId])
}

model Subtask {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title           String
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  completedById   String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([taskId])
  @@index([isCompleted])
}

model Software {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String?
  category     String?  // Desktop App | Web App | SaaS | Mobile App
  description  String?  @db.Text
  defaultPrice Float?
  status       String   @default("Active") // Active | Inactive

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  subscriptions CompanySubscription[]

  @@index([deletedAt])
  @@index([status])
}

model Company {
  id                String   @id @default(cuid())
  companyName       String
  companyNameBangla String?
  contactPerson     String?
  designation       String?
  phone             String?
  email             String?
  address           String?  @db.Text
  district          String?
  subDistrict       String?
  website           String?
  notes             String?  @db.Text

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  subscriptions     CompanySubscription[]

  @@index([deletedAt])
  @@index([district])
}

model CompanySubscription {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  softwareId       String
  software         Software  @relation(fields: [softwareId], references: [id], onDelete: Cascade)

  billingCycle     String    @default("Yearly") // Monthly | Half-Yearly | Yearly | One-Time | Lifetime
  price            Float?
  status           String    @default("Active") // Active | Expiring Soon | Expired | Deactivated | Cancelled

  startDate        DateTime?
  expireDate       DateTime?
  actualExpireDate DateTime?
  notes            String?   @db.Text

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([companyId])
  @@index([softwareId])
  @@index([expireDate])
  @@index([deletedAt])
}

